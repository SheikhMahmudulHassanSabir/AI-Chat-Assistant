# ==============================================================================
# ENVIRONMENT VARIABLES & SECRETS CONFIGURATION GUIDE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Safe for GitHub Pages / Client-Side)
# ------------------------------------------------------------------------------
# These variables can be safely put in supabase-config.js or configured via the UI
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. SUPABASE EDGE FUNCTION SECRETS (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# Set these securely in your Supabase dashboard or via Supabase CLI:
# supabase secrets set AI_API_KEY=hf_...
# supabase secrets set WEB_SEARCH_API_KEY=tvly-...

# AI Provider API Key (Hugging Face / OpenAI)
AI_API_KEY=hf_your_huggingface_access_token_here

# Optional: Dedicated Hugging Face Token (if different from AI_API_KEY)
HUGGINGFACE_API_KEY=hf_your_huggingface_access_token_here

# Optional: Web Search API Key (Tavily or Serper)
WEB_SEARCH_API_KEY=tvly_your_tavily_search_api_key_here
